gap> NumberSmallGroups(3^8);
1396077
gap> SmallGroup(3^8, 1);
<pc group of size 6561 with 8 generators>
gap> SmallGroup(3^8, 1000000);
<pc group of size 6561 with 8 generators>
gap> SmallGroup(3^8, 1396077);
<pc group of size 6561 with 8 generators>

# validate bounds check
gap> SmallGroup(3^8, 1396078);
Error, there are just 1396077 groups of order 6561

# the codes of groups spread over the rank/class layers; the data stores the
# differences between consecutive groups, so a wrong code here means the
# replay went astray rather than that one entry is corrupt
gap> codes := [
>   [ 1, 2742007890566054261095472471998591 ],
>   [ 2, 161888224800529018849417905340950807711 ],
>   [ 59, 6966983493060381409517370591488339528531363231 ],
>   [ 545, 9412317645031986417189099991096575268630506190288668243363417535 ],
>   [ 2219, 417925299583303499629694287997 ],
>   [ 2227, 218653543489933240627393262759959056415870667770782834623 ],
>   [ 2228, 1719856841831624770540536199 ],
>   [ 261663, 63698414812270003243450489 ],
>   [ 500000, 33336409975175580593893794794165244022362399220747151 ],
>   [ 817739, 466567507357639946354399725879748054076371208447837086 ],
>   [ 1000000, 3061149415773475688031216601497663607779578632649191834527 ],
>   [ 1396076, 9705684280422972784769 ],
>   [ 1396077, 0 ] ];;
gap> ForAll( codes, p -> CodePcGroup( SmallGroup( 3^8, p[1] ) ) = p[2] );
true

# again backwards, which has the layers rewind to a checkpoint
gap> ForAll( Reversed( codes ), p -> CodePcGroup( SmallGroup( 3^8, p[1] ) ) = p[2] );
true

# consecutive groups within a layer, the case the replay is built for
gap> List( [ 2219 .. 2227 ], i -> CodePcGroup( SmallGroup( 3^8, i ) ) );
